#!/usr/bin/env bash
set -euo pipefail

# Print the `-P` version flags for Gradle. Releases are tagged
# `vMAJOR.MINOR.PATCH`; snapshots are the next patch. Tagless compatibility
# checkouts use the committed placeholder versions, but release mode still
# requires an exact release tag.

mode="${1:-build}"
repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

release_tag="$(git -C "$repository_root" tag --list 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | head -n1)"
if [[ -z "$release_tag" ]]; then
  if [[ "$mode" == "release" ]]; then
    echo "${0##*/}: no vMAJOR.MINOR.PATCH tag in this checkout" >&2
    echo "Fetch the tags with \`git fetch --tags\`." >&2
    exit 1
  fi
  release_version="$(sed -n 's/^maplibreReleaseVersion=//p' "$repository_root/gradle.properties" | head -n1)"
  snapshot_version="$(sed -n 's/^maplibreSnapshotVersion=//p' "$repository_root/gradle.properties" | head -n1)"
  if [[ -z "$release_version" || -z "$snapshot_version" ]]; then
    echo "${0##*/}: no version tags or release/snapshot placeholders in gradle.properties" >&2
    exit 1
  fi
  exact_tag=""
  source_ref="$(git -C "$repository_root" rev-parse HEAD)"
else
  release_version="${release_tag#v}"

  IFS=. read -r major minor patch <<<"$release_version"
  snapshot_version="${major}.${minor}.$((patch + 1))-SNAPSHOT"

  if exact_tag="$(git -C "$repository_root" describe --tags --exact-match --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null)"; then
    source_ref="$exact_tag"
  else
    exact_tag=""
    source_ref="$(git -C "$repository_root" rev-parse HEAD)"
  fi
fi

case "$mode" in
  # A tagged commit builds as that release even if a newer tag exists, so
  # re-running a workflow on an older tag reproduces that version.
  build)
    if [[ -n "$exact_tag" ]]; then
      version="${exact_tag#v}"
    else
      version="$snapshot_version"
    fi
    ;;
  # A snapshot even on a tagged commit, so the nightly job cannot publish a
  # release version to the snapshot repository.
  snapshot) version="$snapshot_version" ;;
  release)
    if [[ -z "$exact_tag" ]]; then
      echo "${0##*/}: HEAD is not a vMAJOR.MINOR.PATCH tag, so there is no release to publish" >&2
      exit 1
    fi
    version="${exact_tag#v}"
    ;;
  *)
    echo "usage: ${0##*/} [build|snapshot|release]" >&2
    exit 2
    ;;
esac

printf -- '-PmaplibreVersion=%s\n' "$version"
printf -- '-PmaplibreReleaseVersion=%s\n' "$release_version"
printf -- '-PmaplibreSnapshotVersion=%s\n' "$snapshot_version"
printf -- '-PmaplibreSourceRef=%s\n' "$source_ref"
